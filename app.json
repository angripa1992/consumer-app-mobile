{
  "expo": {
    "name": "Klikit",
    "slug": "klikit-consumer-app",
    "scheme": "klikit",
    "version": "1.9.3",
    "orientation": "portrait",
    "icon": "./src/UI/assets/icon1024.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-localization",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/perf",
      [
        "@sentry/react-native/expo",
        {
          "organization": "cressco",
          "project": "klikit"
        }
      ],
      [
        "@config-plugins/detox",
        {
          "subdomains": "*"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "To help you discover nearby restaurants, we need your location. Rest assured, your location is not saved or stored by us.",
          "locationAlwaysPermission": "Even when in the background, we access your location only to suggest nearby restaurants. Your privacy matters; we don't store your location.",
          "locationWhenInUsePermission": "Allow us to access your location to show restaurants close to you. Your location remains private and isn't stored by us."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "14.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "We need your permission to use your camera to scan QR. Your privacy is important to us, and we don't store your photos or videos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:discover.klikit.io"
      ],
      "buildNumber": "198",
      "bundleIdentifier": "klikit.io.consumer",
      "icon": "./src/UI/assets/icon1024.png",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC4wAuAIgOOFQ0AGghXrIPQuo7nDA6Lp_0"
      },
      "usesAppleSignIn": true,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "klikit.io.consumer",
      "versionCode": 198,
      "adaptiveIcon": {
        "foregroundImage": "./src/UI/assets/icon1024.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD3mBFHKUZC1CMyWw7do6GAd1vstufRknU"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "discover.klikit.io",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./src/UI/assets/icon1024.png"
    },
    "extra": {
